# Подхватывается автоматически при `vite build` (production-режим),
# независимо от того, где и как раздаётся собранный dist/. Локальную
# разработку (`npm run dev`) не затрагивает — там действует .env
# (+ свой .env.local поверх, если есть).
VITE_MOCK_MODE=false
VITE_API_URL=https://api.taptap.adamtech.dev
